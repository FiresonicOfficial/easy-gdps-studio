{
  "name": "easy-gdps-studio",
  "version": "1.0.0",
  "description": "EasyGDPS Studio — Multi-version (1.0 to 2.2) Geometry Dash Private Server Setup, Launcher & Dual EXE/APK Client Builder",
  "main": "dist-electron/main/index.js",
  "author": "EasyGDPS Studio",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.node.json && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "fetch-runtimes": "node scripts/fetch-runtimes.js",
    "test:endpoints": "node scripts/test-endpoints.js",
    "test:isolated": "node scripts/test-isolated-suite.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.475.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
